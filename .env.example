# Copy to .env and fill in. Every value below has a default in
# infrastructure/config/settings.py, so the app starts without this file —
# but it will fail on the first LLM call if no provider key is set.
#
# Settings uses extra="forbid": any variable here that is NOT declared in
# settings.py stops the app from booting. That is deliberate — it catches a
# typo'd name at startup instead of silently falling back to a default. In
# particular, the frontend's EXPO_PUBLIC_* variables do not belong here.

# ─── LLM providers ────────────────────────────────────────────────
# Tried in this order by FailoverAdapter: Groq -> Cerebras -> Mistral.
# At least one is required for the /parse-nl* endpoints.
GROQ_API_KEY=
CEREBRAS_API_KEY=
MISTRAL_API_KEY=

# ─── Supabase ─────────────────────────────────────────────────────
# The database is reached through PostgREST rather than a direct Postgres
# connection: the container sleeps on the free tier and a connection pool does
# not survive that cycle. Going through the REST API also keeps row-level
# security in force, since every query runs with the caller's own JWT.
SUPABASE_URL=https://<tu-proyecto>.supabase.co
# Client-safe key: "publishable" (sb_publishable_...) on newer projects, "anon"
# on older ones. It grants nothing by itself — RLS is what scopes the data.
SUPABASE_ANON_KEY=
# Only for projects still signing with the legacy HS256 shared secret. Newer
# ones sign asymmetrically (ES256) and are verified through JWKS, which needs
# no secret — leave this empty for those.
SUPABASE_JWT_SECRET=
# One request per table against the live project at boot, to fail loudly when
# a migration was never applied. Turn off in tests or offline development.
VERIFY_SCHEMA_ON_STARTUP=true

# ─── API ──────────────────────────────────────────────────────────
# Comma-separated allowed origins, or "*" for any.
CORS_ORIGINS=*
# Requests per minute per IP on /parse-nl*. 0 disables the limiter.
RATE_LIMIT_PER_MINUTE=20
LOG_LEVEL=INFO

# ─── Solver ───────────────────────────────────────────────────────
# CP-SAT time budget in seconds.
SCHEDULER_TIMEOUT=5

# ─── Unused today ─────────────────────────────────────────────────
# DATABASE_URL: kept only because settings.py still declares it. The
#   persistence layer it belonged to is dead code, removed in a later step;
#   the database is reached through Supabase now.
# GEMINI_API_KEY: only read by gemini_llm_adapter.py, which is not wired.
# ROUTES_API_KEY: declared in settings.py but never read.
DATABASE_URL=sqlite:///./ikeep.db
GEMINI_API_KEY=
ROUTES_API_KEY=
